# Python
backend/.venv/
__pycache__/
*.pyc

# Secrets — real key files are never committed. The `!` negations keep the
# committed templates visible even if the patterns above are later widened
# to something like `.env*` (Phase 0 remediation).
.env
.env.local
backend/.env
backend/.env.local
!.env.example
!backend/.env.example

# Local data (DB + imported/generated files) — never committed
backend/data/

# Node
frontend/node_modules/
frontend/dist/

# Local tool state (machine-specific, not shared)
.claude/settings.local.json

# OS
.DS_Store

# Generated image outputs (produced by run_*.py scripts) — never committed
backend/gen_out/
backend/gen_out_crocs/
backend/gen_out_slideshow/

# Scratch: files moved here for manual deletion — never committed
_to_delete/

# Benchmark corpus scratch (contact-sheet copies / ad-hoc outputs) — regenerable
backend/benchmark_corpus/_review2/
backend/benchmark_corpus/_anim/
backend/benchmark_corpus/_adhoc/
